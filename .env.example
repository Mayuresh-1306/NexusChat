# ===================================================
# NexusChat Environment Variables Configuration
# ===================================================

# Port to run the application server on
PORT=3000

# Application environment ('development' | 'production')
NODE_ENV=development

# JSON Web Token Secret Key (Change this to a long random secret in production)
JWT_SECRET=nexus_chat_secure_jwt_secret_key_2026

# MongoDB Connection String:
# ----------------------------------------------------
# 1. For MongoDB Atlas (Recommended for Cloud / Presentation):
#    Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_chat?retryWrites=true&w=majority
#
# 2. For Local MongoDB:
#    Format: mongodb://localhost:27017/nexus_chat
#
# 3. For Docker Compose:
#    Format: mongodb://mongo:27017/nexus_chat
#
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus_chat?retryWrites=true&w=majority
